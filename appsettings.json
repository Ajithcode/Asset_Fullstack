{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "ConsumerName": "worker-network-service-1"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?directConnection=true",
    "Database": "Asset360"
  },
  "Mqtt": {
    "Url": "mqtt://165.22.215.89:1883",
    "Host": "165.22.215.89",
    "Port": 1883,
    "ClientId": "worker-network-service-1",
    "Username": "root",
    "Password": "Admin@123",
    "UseTls": false,
    "CleanSession": true,
    "KeepAliveSeconds": 60,
    "ReconnectDelaySeconds": 5,
    "TargetStream": "networkserver_stream",
    "PayloadField": "msg",
    "Subscriptions": [
      { "Name": "Send", "Topic": "send", "Qos": 1 }
    ]
  },
  "Http": {
    "ListenUrl": "http://0.0.0.0:5002",
    "TargetStream": "networkserver_stream",
    "PayloadField": "msg",
    "Methods": [
      { "Name": "Test", "Method": "POST", "Url": "/test" }
    ]
  },
  "StreamMappings": [
    {
      "Stream": "networkserver_stream",
      "Collection": "NetworkTimeSeries",
      "Group": "timeseries-writer",
      "StartId": "0",
      "PayloadField": "msg",
      "TimestampFields": [ "timestamp" ],
      "Meta": { "clientid": "clientid", "gatewayid": "gatewayid", "tagid": "tagid" },
      "Fields": [
        { "Name": "rssi", "Source": "rssi" },
        { "Name": "battery", "Source": "batterypercentage" },
        { "Name": "raw", "Source": "raw" },
        { "Name": "location", "Longitude": "longitude", "Latitude": "latitude" },
        { "Name": "position", "Object": { "x": "x", "y": "y", "z": "z" } },
        { "Name": "status", "Source": "status" },
        { "Name": "device_trigger", "Source": "device_trigger" },
        { "Name": "coordinates", "Source": "coordinates", "Array": true }
      ],
      "AttributesField": "sensor_attributes",
      "DeleteAfterAck": true
    }
  ]
}
