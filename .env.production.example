# Copy to .env on the server (never commit .env) and fill in every value.
# Used by docker-compose.prod.yml.

# Public hostname of the API; its DNS A record must point at this server.
DOMAIN=api.example.com

# MongoDB Atlas connection string. Add this server's IP under Atlas > Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# New random key, at least 32 bytes. Generate with: openssl rand -base64 48
Jwt__SigningKey=

# Encrypts users' authenticator (TOTP) secrets. 32 bytes, base64. Generate with: openssl rand -base64 32
# Set it before users enroll; changing it later makes them set up their authenticator app again.
TwoFactor__EncryptionKey=

# Email for login OTPs. Without Smtp__Host, OTP emails are not sent.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Asset360

# Set to false to hide the API docs at /swagger.
Swagger__Enabled=true
