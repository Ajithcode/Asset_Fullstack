# Environment variables read by NetworkServer (override appsettings.json; '__' = nesting, numbers = array index).
# Copy to .env and fill in. Never commit real values.
ASPNETCORE_ENVIRONMENT=
# Listen address. Use Urls, not ASPNETCORE_URLS (appsettings.json "Urls" takes precedence over ASPNETCORE_URLS).
Urls=
Mqtt__Port=
Mqtt__Username=
Mqtt__Password=
Redis__ConnectionString=
Redis__Stream=
Redis__MaxLength=
Mongo__ConnectionString=
Mongo__Database=
Mongo__Collection=
Mongo__TimeSeriesCollection=
Aggregation__WindowSeconds=
Aggregation__AllowedTags__0=
Aggregation__RepeaterTags__0=
# External MQTT broker to subscribe to (disabled when Host or Topics is empty)
MqttBridge__Host=
MqttBridge__Port=
MqttBridge__ClientId=
MqttBridge__Username=
MqttBridge__Password=
MqttBridge__UseTls=
MqttBridge__Qos=
MqttBridge__Topics__0=
